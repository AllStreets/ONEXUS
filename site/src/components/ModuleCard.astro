---
interface Props {
  name: string;
  description: string;
  tier: string;
  status?: string;
  href?: string;
}

const { name, description, tier, status = 'BUILT', href } = Astro.props;

const tierColors: Record<string, string> = {
  'Kernel': '#00d4ff',
  'Perception': '#7b5cff',
  'Intelligence': '#3b82f6',
  'Action': '#ff9d00',
  'Advanced Intelligence': '#ff4d6a',
  'Orchestration': '#e040fb',
  'Network': '#00ff88',
  'Differentiation': '#ff6b9d',
  'Infrastructure': '#fbbf24',
  'Community': '#34d399',
  'Agents': '#00ffaa',
};

const accentColor = tierColors[tier] ?? '#00d4ff';
const Tag = href ? 'a' : 'div';
---

{href ? (
  <a class="module-card module-card--link" href={href} style={`--card-accent: ${accentColor};`}>
    <div class="card-header">
      <span class="card-name">{name}</span>
      <span class="card-status">{status}</span>
    </div>
    <p class="card-description">{description}</p>
    <span class="card-tier">{tier}</span>
  </a>
) : (
  <div class="module-card" style={`--card-accent: ${accentColor};`}>
    <div class="card-header">
      <span class="card-name">{name}</span>
      <span class="card-status">{status}</span>
    </div>
    <p class="card-description">{description}</p>
    <span class="card-tier">{tier}</span>
  </div>
)}

<style>
  /* Module card: a graphite card on the site tokens. The tier color is
     only a small mark; the accent is reserved for hover and focus. */
  .module-card {
    background: var(--nx-gray-100);
    border: 1px solid var(--nx-line-2);
    border-radius: var(--nx-radius-md);
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 120ms var(--nx-ease), background 120ms var(--nx-ease);
    min-width: 0;
    overflow: hidden;
  }
  .module-card--link { text-decoration: none; color: inherit; cursor: pointer; }
  .module-card--link:hover { border-color: var(--nx-line-3); background: var(--nx-gray-200); }
  .card-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .card-name {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.95rem; font-weight: 600; color: var(--nx-fg-1);
  }
  .card-name::before { content: ''; width: 8px; height: 8px; border-radius: 3px; background: var(--card-accent); }
  .card-status {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em;
    padding: 0.15em 0.5em; border-radius: 999px;
    border: 1px solid var(--nx-line-2); background: var(--nx-gray-200);
    color: var(--nx-fg-3); white-space: nowrap;
  }
  .card-description { font-size: 0.85rem; color: var(--nx-fg-2); line-height: 1.55; margin: 0; }
  .card-tier { margin-top: auto; font-size: 0.72rem; font-weight: 500; color: var(--nx-fg-3); }
</style>
