---
// Landing hero. Uses the site tokens in src/styles/custom.css, which mirror
// Aurora's tokens.css.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="not-content">
<nav class="nx-subnav" aria-label="Documentation sections">
  <div class="nx-subnav-inner">
    <a href={`${base}/getting-started/installation/`}>Setup</a>
    <a href={`${base}/architecture/overview/`}>Architecture</a>
    <a href={`${base}/concepts/earned-autonomy/`}>Concepts</a>
    <a href={`${base}/guides/building-a-module/`}>Guides</a>
    <a href={`${base}/reference/routing/`}>Reference</a>
  </div>
</nav>

<section class="nx-hero">
  <div class="nx-hero-copy">
    <svg class="nx-hero-mark" width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8.25" stroke="currentColor" stroke-width="1.75" />
      <circle cx="12" cy="12" r="3" fill="currentColor" />
      <circle cx="17.83" cy="6.17" r="1.9" fill="currentColor" stroke="#0b0c0f" stroke-width="1.4" />
    </svg>
    <p class="nx-hero-eyebrow">ONEXUS · local-first agent runtime</p>
    <h1 class="nx-hero-title">Run AI agents on your own machine, and see every decision they make.</h1>
    <p class="nx-hero-tagline">
      Every tool call an agent routes through ONEXUS is checked against what the agent declared,
      and every decision is written to an audit ledger.
    </p>

    <div class="nx-hero-actions">
      <a href={`${base}/getting-started/installation/`} class="nx-btn nx-btn-primary">Get started</a>
      <a href="https://github.com/AllStreets/ONEXUS" class="nx-btn" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        GitHub
      </a>
    </div>

    <dl class="nx-hero-stats">
      <div><dt>Cognitive modules</dt><dd>9</dd></div>
      <div><dt>Kernel components</dt><dd>5</dd></div>
      <div><dt>LLM providers</dt><dd>3</dd></div>
      <div><dt>Cloud dependencies</dt><dd>0</dd></div>
    </dl>
  </div>

  <div class="nx-hero-terminal" aria-label="Quickstart">
    <div class="nx-terminal-head">
      <span>Quickstart</span>
      <span class="nx-terminal-shell">zsh</span>
    </div>
    <pre><code><span class="c"># clone and install</span>
<span class="p">$</span> git clone https://github.com/AllStreets/ONEXUS.git
<span class="p">$</span> pip install -e ".[all]"

<span class="c"># launch the kernel</span>
<span class="p">$</span> onexus run</code></pre>
  </div>
</section>

<figure class="nx-hero-shot">
  <img src={`${base}/app-conversation.png`} width="1440" height="900"
       alt="Aurora, the ONEXUS app: a workspace conversation with an inline Aegis permission card and the cockpit rail." />
  <figcaption>Aurora, the ONEXUS app. A sensitive tool call pauses for consent; the rail keeps trust and permissions in view.</figcaption>
</figure>

</div>

<style>
  .nx-subnav {
    position: sticky;
    top: var(--sl-nav-height, 3.5rem);
    z-index: 10;
    background: rgba(11, 12, 15, 0.9);
    border-bottom: 1px solid var(--nx-line-1);
    backdrop-filter: blur(8px);
  }
  .nx-subnav-inner {
    max-width: 64rem; margin: 0 auto;
    display: flex; gap: 0.25rem;
    padding: 0 1.5rem;
    overflow-x: auto; scrollbar-width: none;
  }
  .nx-subnav-inner::-webkit-scrollbar { display: none; }
  .nx-subnav a {
    position: relative;
    padding: 0.75rem 0.75rem;
    font-size: 0.85rem; font-weight: 500;
    color: var(--nx-fg-3);
    text-decoration: none; white-space: nowrap;
    transition: color 120ms var(--nx-ease);
  }
  .nx-subnav a:hover { color: var(--nx-fg-1); }
  .nx-subnav a::after {
    content: ''; position: absolute; left: 0.75rem; right: 0.75rem; bottom: -1px;
    height: 2px; border-radius: 2px; background: var(--nx-accent); opacity: 0;
    transition: opacity 120ms var(--nx-ease);
  }
  .nx-subnav a:hover::after { opacity: 1; }

  .nx-hero {
    max-width: 64rem; margin: 0 auto;
    padding: 5rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: end;
    background: radial-gradient(70% 60% at 20% 0%, rgba(var(--nx-accent-rgb), 0.07), transparent 70%);
  }
  @media (max-width: 900px) { .nx-hero { grid-template-columns: minmax(0, 1fr); padding-top: 3.5rem; gap: 2rem; } }

  .nx-hero-copy { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
  .nx-hero-mark { color: var(--nx-accent); filter: drop-shadow(0 0 10px rgba(var(--nx-accent-rgb), 0.35)); }
  .nx-hero-eyebrow {
    margin: 0;
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--nx-accent);
  }
  .nx-hero-title {
    margin: 0;
    font-family: var(--nx-font-ui);
    font-size: clamp(2rem, 3.8vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--nx-fg-1);
    border: 0;
  }
  .nx-hero-tagline { margin: 0; font-size: 1.1rem; line-height: 1.6; color: var(--nx-fg-2); max-width: 36rem; }

  .nx-hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .nx-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    height: 2.5rem; padding: 0 1.1rem;
    border-radius: var(--nx-radius-sm);
    border: 1px solid var(--nx-line-2);
    background: var(--nx-gray-200);
    color: var(--nx-fg-1);
    font-size: 0.9rem; font-weight: 500;
    text-decoration: none;
    transition: background 120ms var(--nx-ease), border-color 120ms var(--nx-ease), box-shadow 200ms var(--nx-ease);
  }
  .nx-btn:hover { background: var(--nx-gray-300); border-color: var(--nx-line-3); color: var(--nx-fg-1); }
  .nx-btn-primary { background: var(--nx-accent); border-color: transparent; color: var(--nx-fg-on-accent); font-weight: 600; }
  .nx-btn-primary:hover { background: var(--nx-accent); border-color: transparent; color: var(--nx-fg-on-accent); box-shadow: 0 0 24px -6px rgba(var(--nx-accent-rgb), 0.55); }

  .nx-hero-stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem; margin: 1.5rem 0 0; padding-top: 1.25rem;
    border-top: 1px solid var(--nx-line-1);
  }
  .nx-hero-stats div { display: flex; flex-direction: column; justify-content: flex-start; gap: 0.15rem; margin: 0; }
  .nx-hero-stats dd { order: -1; }
  .nx-hero-stats dt { font-size: 0.75rem; line-height: 1.3; color: var(--nx-fg-3); margin: 0; }
  .nx-hero-stats dd { margin: 0; font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; color: var(--nx-fg-1); font-variant-numeric: tabular-nums; }
  @media (max-width: 560px) { .nx-hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .nx-hero-terminal {
    min-width: 0;
    background: var(--nx-gray-0);
    border: 1px solid var(--nx-line-2);
    border-radius: var(--nx-radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 64px -24px rgba(0, 0, 0, 0.8);
  }
  .nx-terminal-head {
    display: flex; justify-content: space-between;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--nx-line-1);
    background: var(--nx-gray-100);
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--nx-fg-3);
  }
  .nx-terminal-shell { font-family: var(--nx-font-mono); text-transform: none; letter-spacing: 0; font-weight: 400; }
  .nx-hero-terminal pre { margin: 0; padding: 1.1rem 1.25rem; background: transparent; border: 0; overflow-x: auto; }
  .nx-hero-terminal code { font-family: var(--nx-font-mono); font-size: 0.8rem; line-height: 1.85; color: var(--nx-fg-1); background: none; }
  .nx-hero-terminal .c { color: var(--nx-fg-3); }
  .nx-hero-terminal .p { color: var(--nx-accent); user-select: none; }

  .nx-hero-shot { max-width: 64rem; margin: 0 auto; padding: 0 1.5rem 4rem; }
  .nx-hero-shot img {
    display: block; width: 100%; height: auto;
    border-radius: var(--nx-radius-lg);
    border: 1px solid var(--nx-line-2);
    box-shadow: 0 40px 96px -32px rgba(0, 0, 0, 0.9), 0 0 0 1px rgba(255, 255, 255, 0.02);
  }
  .nx-hero-shot figcaption { margin-top: 0.85rem; font-size: 0.85rem; color: var(--nx-fg-3); text-align: center; }
</style>
